<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CA1707 (no underscores in identifiers) fights the xUnit convention of
         naming test methods like a sentence (Method_condition_expectedResult) —
         suppressed here only, not for the shipping projects. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pos.Core\Pos.Core.csproj" />
    <ProjectReference Include="..\..\src\Pos.Infra\Pos.Infra.csproj" />
    <ProjectReference Include="..\..\src\Pos.Hardware\Pos.Hardware.csproj" />
    <ProjectReference Include="..\..\src\Pos.Desktop\Pos.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Renders Avalonia views off-screen (no display server needed — this is what lets
         the UI smoke test run in CI). Not Avalonia.Headless.XUnit: that package pulls in
         xunit.v3, which collides with this project's xunit v2 (FactAttribute defined in
         both) — HeadlessUiTests bootstraps the headless app itself instead, with plain
         [Fact]. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>