<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pos.Desktop.ViewModels"
        xmlns:views="using:Pos.Desktop.Views"
        x:Class="Pos.Desktop.MainWindow"
        x:DataType="vm:AppViewModel"
        Title="POS Terminal"
        Width="1024" Height="700">
  <ContentControl Content="{Binding Current}">
    <ContentControl.DataTemplates>
      <DataTemplate DataType="vm:SetupWizardViewModel">
        <views:SetupWizardView />
      </DataTemplate>
      <DataTemplate DataType="vm:LockScreenViewModel">
        <views:LockScreenView />
      </DataTemplate>
      <DataTemplate DataType="vm:MainViewModel">
        <views:MainView />
      </DataTemplate>
    </ContentControl.DataTemplates>
  </ContentControl>
</Window>
