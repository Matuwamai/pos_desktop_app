<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pos.Desktop.ViewModels"
        xmlns:views="using:Pos.Desktop.Views"
        x:Class="Pos.Desktop.MainWindow"
        x:DataType="vm:AppViewModel"
        Title="POS Terminal"
        Width="1024" Height="700">
  <Grid>
    <ContentControl Content="{Binding Current}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:SetupWizardViewModel">
          <views:SetupWizardView />
        </DataTemplate>
        <DataTemplate DataType="vm:LockScreenViewModel">
          <views:LockScreenView />
        </DataTemplate>
        <DataTemplate DataType="vm:CashierViewModel">
          <views:CashierView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
    <Border IsVisible="{Binding FatalError, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{StaticResource DangerSurfaceBrush}" Padding="24">
      <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="640">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="⚠" FontSize="22" Foreground="{StaticResource DangerBrush}" />
            <TextBlock Text="Couldn't start the terminal" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding FatalError}" Foreground="#ff8080" FontFamily="monospace" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{StaticResource WarningSurfaceBrush}" Padding="12" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="ⓘ" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" />
        <TextBlock Text="{Binding Notice}" Foreground="#fef3c7" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
