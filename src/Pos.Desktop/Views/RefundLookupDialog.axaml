<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pos.Desktop.ViewModels"
        xmlns:api="using:Pos.Infra.Api"
        x:Class="Pos.Desktop.Views.RefundLookupDialog"
        x:DataType="vm:RefundLookupDialogViewModel"
        Title="Refunds" Width="480" Height="600"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">

    <TextBlock Text="Only a manager or owner can process a refund." Foreground="#dc2626" TextWrapping="Wrap" IsVisible="{Binding !HasPermission}" />
    <TextBlock Text="Connect to the network to process a refund." Foreground="#dc2626" TextWrapping="Wrap" IsVisible="{Binding ShowOfflineMessage}" />

    <!-- Search step -->
    <StackPanel IsVisible="{Binding IsSearchStep}" Spacing="10">
      <StackPanel IsVisible="{Binding CanRefund}" Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding SearchText}" PlaceholderText="Order # or customer name" Width="320" />
          <Button Content="Search" Command="{Binding SearchCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="api:OrderSummaryDto">
              <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="6" Margin="0,2">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding OrderNumber, StringFormat='#{0}'}" FontWeight="Bold" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding CreatedAt}" FontSize="11" />
                    <TextBlock Text="{Binding Customer.Name}" FontSize="11" IsVisible="{Binding Customer, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat='{}{0:0.00}'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button Grid.Column="3" Content="Refund"
                          Command="{Binding $parent[ItemsControl].((vm:RefundLookupDialogViewModel)DataContext).SelectOrderCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>

    <!-- Refund step -->
    <StackPanel IsVisible="{Binding !IsSearchStep}" Spacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding SelectedOrder.OrderNumber, StringFormat='Order #{0}'}" FontWeight="Bold" FontSize="16" />
        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.Total, StringFormat='{}{0:0.00}'}" FontWeight="Bold" FontSize="16" />
      </Grid>

      <ItemsControl ItemsSource="{Binding RefundLines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RefundLineViewModel">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" />
                <TextBlock Text="{Binding RemainingQty, StringFormat='{}{0} of this item can still be refunded'}" FontSize="11" Foreground="#78716c" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBox Text="{Binding RefundQtyText}" PlaceholderText="Qty to refund" Width="100" />
                  <TextBlock Text="{Binding RefundAmountPreview, StringFormat='= {0:0.00}'}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel>
          <TextBlock Text="Refund method" FontSize="11" />
          <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding RefundMethod}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsGiftCard}">
          <TextBlock Text="Gift card code" FontSize="11" />
          <TextBox Text="{Binding GiftCardCode}" />
        </StackPanel>
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Reason (optional)" FontSize="11" />
        <TextBox Text="{Binding Reason}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Back to search" Command="{Binding BackToSearchCommand}" />
        <Button Content="Submit refund" Command="{Binding SubmitRefundCommand}" IsEnabled="{Binding CanSubmitRefund}" />
      </StackPanel>
    </StackPanel>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="#dc2626" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap" IsVisible="{Binding SuccessMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Button Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
  </StackPanel>
</Window>
