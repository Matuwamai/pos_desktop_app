<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.ViewModels"
             x:Class="Pos.Desktop.Views.CashierView"
             x:DataType="vm:CashierViewModel"
             Name="Root">
  <DockPanel>
  
    <Border DockPanel.Dock="Top" Background="#1F2937" Padding="12,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                   Fill="{Binding IsOnline, Converter={x:Static vm:BoolConverters.OnlineColor}}" />
          <TextBlock Text="{Binding SyncStatus}" Foreground="White" VerticalAlignment="Center" />
          <Border Background="#78350f" CornerRadius="10" Padding="8,2" IsVisible="{Binding PendingSaleCount}">
            <TextBlock Foreground="#fbbf24" FontSize="12"
                       Text="{Binding PendingSaleCount, StringFormat='{}{0} pending'}" />
          </Border>
        </StackPanel>

        <TextBlock Grid.Column="2" Text="{Binding SignedInAs.Name}" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />

        <Button Grid.Column="3" Content="Sync now" Command="{Binding SyncNowCommand}" IsEnabled="{Binding !IsSyncing}" Margin="0,0,6,0" />

        <Button Grid.Column="4" Content="Restart to update" Click="OnRestartToUpdateClick"
                IsVisible="{Binding $parent[Window].((vm:AppViewModel)DataContext).UpdateAvailable}"
                Background="{StaticResource SuccessBrush}" Foreground="White" FontWeight="SemiBold" Margin="0,0,6,0" />

        <Button Grid.Column="5" Content="☰ Menu">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Refunds" Command="{Binding OpenRefundCommand}" />
              <MenuItem Header="Printer settings" Command="{Binding OpenPrinterSettingsCommand}" />
              <MenuItem Header="Close drawer" Command="{Binding CloseDrawerCommand}" />
              <Separator />
              <MenuItem Header="Open logs folder" Click="OnOpenLogsFolderClick" />
              <Separator />
              <MenuItem Header="Lock" Command="{Binding LogoutCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{StaticResource DangerSurfaceBrush}" Padding="12,8">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
    </Border>

    <Grid ColumnDefinitions="2*,*">
      <!-- Catalog -->
      <DockPanel Grid.Column="0" Margin="12">
        <TextBox DockPanel.Dock="Top" Name="SearchBox" PlaceholderText="Search or scan a barcode (F2)" Text="{Binding SearchText}" Margin="0,0,0,8" />
        <ComboBox DockPanel.Dock="Top" Margin="0,0,0,8" PlaceholderText="All categories"
                  ItemsSource="{Binding Categories}" SelectedValue="{Binding SelectedCategoryId}" SelectedValueBinding="{Binding Id}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Products}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CatalogProduct">
                <Button Width="150" Height="172" Margin="5" Padding="0" Background="Transparent" BorderThickness="0"
                        Command="{Binding #Root.((vm:CashierViewModel)DataContext).PickProductCommand}" CommandParameter="{Binding}">
                  <Border CornerRadius="{StaticResource AppCornerRadius}" ClipToBounds="True">
                    <Grid RowDefinitions="*,Auto">
                      <Border Grid.Row="0" Background="{Binding ProductId, Converter={x:Static vm:TextConverters.ProductColor}}">
                        <TextBlock Text="{Binding Name, Converter={x:Static vm:TextConverters.Initial}}"
                                   FontSize="30" FontWeight="Bold" Foreground="#1F2937"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Row="1" Background="#1A1F2937" Padding="8">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Variants[0].PriceText}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Row="0" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentBrush}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                              IsVisible="{Binding #QtyBadgeText.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Name="QtyBadgeText" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock.Text>
                            <MultiBinding Converter="{x:Static vm:TextConverters.CartQuantityBadge}">
                              <Binding />
                              <Binding ElementName="Root" Path="((vm:CashierViewModel)DataContext).CartRows.Count" />
                              <Binding ElementName="Root" Path="((vm:CashierViewModel)DataContext)" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <DockPanel Grid.Column="1" Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="4,0,4,8">
          <Button Content="Customer" Command="{Binding OpenCustomerCommand}" />
          <Button Content="Discount" Command="{Binding OpenDiscountCommand}" />
          <Button Content="Hold" Command="{Binding HoldTicketCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding CustomerName, StringFormat='Customer: {0}'}"
                   IsVisible="{Binding CustomerName, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="4,0,4,8" />

        <Border DockPanel.Dock="Top" Classes="card" IsVisible="{Binding HeldTickets.Count}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="Held tickets" FontWeight="Bold" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding HeldTickets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HeldTicketSummary">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Resume"
                            Command="{Binding #Root.((vm:CashierViewModel)DataContext).ResumeHeldTicketCommand}" CommandParameter="{Binding Id}" Margin="0,0,4,0" />
                    <Button Grid.Column="2" Content="✕"
                            Command="{Binding #Root.((vm:CashierViewModel)DataContext).DiscardHeldTicketCommand}" CommandParameter="{Binding Id}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,8,0,0">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Subtotal" /><TextBlock Grid.Column="1" Text="{Binding SubtotalText}" /></Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding DiscountTotal}"><TextBlock Text="Discount" /><TextBlock Grid.Column="1" Text="{Binding DiscountTotalText}" Foreground="{StaticResource DangerBrush}" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Tax" /><TextBlock Grid.Column="1" Text="{Binding TaxTotalText}" /></Grid>
            <Separator Margin="0,2" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Currency, StringFormat='Total ({0})'}" FontWeight="Bold" FontSize="18" /><TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="Bold" FontSize="18" /></Grid>
            <Button Content="Pay (F4)" Command="{Binding PayCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"
                    Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
          </StackPanel>
        </Border>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding CartRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CartLineRow">
                <Border Classes="card" Margin="0,4" Padding="10">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding ProductName}" FontWeight="Bold" />
                      <TextBlock Text="{Binding ModifiersSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" IsVisible="{Binding ModifiersSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="−" Width="32" Padding="0" MinHeight="32"
                            Command="{Binding #Root.((vm:CashierViewModel)DataContext).DecrementLineCommand}" CommandParameter="{Binding Key}" />
                    <TextBlock Grid.Column="2" Text="{Binding Quantity}" VerticalAlignment="Center" Margin="8,0" />
                    <Button Grid.Column="3" Content="+" Width="32" Padding="0" MinHeight="32"
                            Command="{Binding #Root.((vm:CashierViewModel)DataContext).IncrementLineCommand}" CommandParameter="{Binding Key}" />
                    <TextBlock Grid.Column="4" Text="{Binding LineTotalText}" VerticalAlignment="Center" Margin="8,0,0,0" Width="60" TextAlignment="Right" FontWeight="SemiBold" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
