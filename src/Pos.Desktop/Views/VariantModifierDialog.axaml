<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pos.Desktop.ViewModels"
        x:Class="Pos.Desktop.Views.VariantModifierDialog"
        x:DataType="vm:VariantModifierDialogViewModel"
        Title="{Binding ProductName}" Width="440" Height="540"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer Padding="20">
    <StackPanel Spacing="14">
      <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="Bold" />

      <StackPanel IsVisible="{Binding !!Variants.Count}" Spacing="6">
        <TextBlock Text="Size / variant" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Variants}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CatalogVariant">
              <Button Content="{Binding Sku}" Margin="0,2" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding $parent[ItemsControl].((vm:VariantModifierDialogViewModel)DataContext).SelectVariantCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModifierGroupSelectionViewModel">
            <StackPanel Margin="0,4,0,0" Spacing="6">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Requirement}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModifierOptionSelectionViewModel">
                    <ToggleButton IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding ToggleCommand}" Margin="0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding PriceAdjustmentText}" IsVisible="{Binding PriceAdjustment}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                      </Grid>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" Margin="0,4,0,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="Qty" VerticalAlignment="Center" Margin="0,0,10,0" />
          <NumericUpDown Grid.Column="1" Value="{Binding Quantity}" Minimum="1" Width="110" />
          <TextBlock Grid.Column="3" Text="{Binding PreviewUnitPriceText, StringFormat='{}{0} each'}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="Add to cart" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}"
                Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
