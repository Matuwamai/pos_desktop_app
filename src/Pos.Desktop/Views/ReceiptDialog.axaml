<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Pos.Core.Interfaces"
        xmlns:vm="using:Pos.Desktop.ViewModels"
        x:Class="Pos.Desktop.Views.ReceiptDialog"
        x:DataType="vm:ReceiptDialogViewModel"
        Title="Sale complete" Width="380" Height="540" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <Button DockPanel.Dock="Bottom" Content="New sale" Command="{Binding NewSaleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,12,0,0"
            Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
    <ScrollViewer>
      <StackPanel Spacing="4" x:DataType="vm:ReceiptDialogViewModel">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,4">
          <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="18" />
          <TextBlock Text="{Binding Receipt.TenantName}" FontWeight="Bold" FontSize="16" />
        </StackPanel>
        <TextBlock Text="{Binding Receipt.LocationName}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Receipt.TerminalReceiptNo, StringFormat='{}{0}'}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Receipt.Currency}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock Text="{Binding Receipt.CashierName, StringFormat='Served by {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"
                   IsVisible="{Binding Receipt.ShowCashierName}" />
        <TextBlock Text="{Binding Receipt.CustomerName, StringFormat='Customer: {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"
                   IsVisible="{Binding Receipt.ShowCustomerNameLine}" Margin="0,0,0,4" />

        <ItemsControl ItemsSource="{Binding Receipt.Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:ReceiptLine">
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Description}" />
                  <TextBlock Text="{Binding ModifiersSummary, StringFormat='+ {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                             IsVisible="{Binding ModifiersSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LineTotalText}" VerticalAlignment="Top" FontWeight="SemiBold" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0,8" />
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Subtotal" /><TextBlock Grid.Column="1" Text="{Binding Receipt.SubtotalText}" /></Grid>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Receipt.DiscountTotal}"><TextBlock Text="Discount" /><TextBlock Grid.Column="1" Text="{Binding Receipt.DiscountTotalText}" Foreground="{StaticResource DangerBrush}" /></Grid>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Tax" /><TextBlock Grid.Column="1" Text="{Binding Receipt.TaxTotalText}" /></Grid>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Receipt.HasCashRoundingAdjustment}"><TextBlock Text="Rounding" /><TextBlock Grid.Column="1" Text="{Binding Receipt.CashRoundingAdjustmentText}" /></Grid>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Total" FontWeight="Bold" FontSize="16" /><TextBlock Grid.Column="1" Text="{Binding Receipt.TotalText}" FontWeight="Bold" FontSize="16" /></Grid>

        <Separator Margin="0,8" />
        <ItemsControl ItemsSource="{Binding Receipt.Payments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:ReceiptPayment">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Method}" /><TextBlock Grid.Column="1" Text="{Binding AmountText}" /></Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Receipt.FooterMessageText}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
