<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pos.Desktop.ViewModels"
        x:Class="Pos.Desktop.Views.DrawerCloseDialog"
        x:DataType="vm:DrawerCloseDialogViewModel"
        Title="Close the cash drawer" Width="340" Height="240" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="Enter the cash counted in the drawer." TextWrapping="Wrap" />
    <TextBox Text="{Binding ClosingCashText}" PlaceholderText="0.00" />
    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,Auto,Auto">
      <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="2" Content="Close drawer" Command="{Binding CloseCommand}" />
    </Grid>
  </StackPanel>
</Window>
