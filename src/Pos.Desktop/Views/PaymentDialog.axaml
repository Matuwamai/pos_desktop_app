<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pos.Desktop.ViewModels"
        x:Class="Pos.Desktop.Views.PaymentDialog"
        x:DataType="vm:PaymentDialogViewModel"
        Title="Payment" Width="440" Height="600"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Total due" FontWeight="Bold" FontSize="18" /><TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:0.00}'}" FontWeight="Bold" FontSize="18" /></Grid>
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Remaining" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding Remaining, StringFormat='{}{0:0.00}'}" Foreground="{StaticResource MutedBrush}" /></Grid>

    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource AppCornerRadius}" Padding="10" IsVisible="{Binding HasMpesaLine}">
      <TextBlock Text="{Binding MpesaHint}" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <ItemsControl ItemsSource="{Binding Lines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TenderLineViewModel">
          <Border Classes="card" Margin="0,4">
            <StackPanel Spacing="6">
              <ComboBox ItemsSource="{Binding $parent[ItemsControl].((vm:PaymentDialogViewModel)DataContext).Methods}" SelectedItem="{Binding Method}" />
              <TextBox Text="{Binding AmountText}" PlaceholderText="Amount" />

              <StackPanel IsVisible="{Binding IsMpesaWithStk}" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsSendingStk}">
                  <TextBox Text="{Binding StkPhoneNumber}" PlaceholderText="2547XXXXXXXX" />
                  <Button Content="Send prompt"
                          Command="{Binding $parent[ItemsControl].((vm:PaymentDialogViewModel)DataContext).SendStkPushCommand}" CommandParameter="{Binding}" />
                </StackPanel>
                <TextBlock Text="Waiting for the customer to approve on their phone…" FontSize="12" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding IsSendingStk}" />
                <TextBlock Text="{Binding StkStatusText}" FontSize="12" Foreground="{StaticResource DangerBrush}" IsVisible="{Binding HasStkStatus}" />
              </StackPanel>

              <TextBox Text="{Binding TransactionRef}" PlaceholderText="M-Pesa confirmation code" IsVisible="{Binding IsMpesa}" />
              <TextBox Text="{Binding TransactionRef}" PlaceholderText="Reference (card/other)" IsVisible="{Binding IsCardOrOther}" />
              <Button Content="Remove line" HorizontalAlignment="Left"
                      Command="{Binding $parent[ItemsControl].((vm:PaymentDialogViewModel)DataContext).RemoveLineCommand}" CommandParameter="{Binding}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button Content="+ Split payment" Command="{Binding AddLineCommand}" HorizontalAlignment="Left" />

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Content="+5" Command="{Binding QuickCashCommand}" CommandParameter="5" />
      <Button Content="+10" Command="{Binding QuickCashCommand}" CommandParameter="10" />
      <Button Content="+20" Command="{Binding QuickCashCommand}" CommandParameter="20" />
      <Button Content="+50" Command="{Binding QuickCashCommand}" CommandParameter="50" />
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
      <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="2" Content="Complete sale" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}"
              Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
    </Grid>
  </StackPanel>
</Window>
